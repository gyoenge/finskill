# Agent Chat 의 LLM 호출에 사용됩니다.
# 키가 없으면 FinSkill 은 자동으로 결정론적 Fallback Router 로 동작합니다.
# (Skill 라우팅 / Skill Gap / Trace 는 키 없이도 모두 동작합니다.)
ANTHROPIC_API_KEY=sk-ant-...

# identity-linked API key 를 쓰는 경우 필수입니다.
# 이 값이 없으면 다음 오류로 호출이 실패하고 Fallback 으로 넘어갑니다:
#   400 anthropic-workspace-id is required when authenticating with an identity-linked API key
# Anthropic Console → Settings → Workspaces 에서 확인할 수 있습니다. (형식: wrkspc_...)
# 일반(workspace-scoped) 키라면 비워두세요.
ANTHROPIC_WORKSPACE_ID=

# 선택: 모델 지정 (기본값 claude-sonnet-5)
# FINSKILL_MODEL=claude-sonnet-5

# 공공데이터포털(data.go.kr) 일반 인증키 — LH 공고 실시간 조회에 사용
# 없으면 해당 Skill 이 "키 미설정"을 사용자에게 알리고, 다른 Skill 은 정상 동작합니다.
DATA_GO_KR_SERVICE_KEY=
